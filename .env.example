# Postgres connection string (ignored by docker-compose, which builds it from POSTGRES_PASSWORD)
DATABASE_URL="postgresql://assurance:change-me@localhost:5432/assurance?schema=public"

# Public URL of the app (no trailing slash)
NEXTAUTH_URL="https://assurance.itutitech.com"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# The first Ituti admin. This email can always sign in and is made an Ituti admin on first login.
BOOTSTRAP_ADMIN_EMAIL="nayan@itutitech.com"

# Outgoing email for sign-in links and invitations (Microsoft 365 example).
# Leave SMTP_HOST empty in development to print links to the server log instead.
SMTP_HOST="smtp.office365.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Ituti AI Assurance <assurance@itutitech.com>"

# Optional: enables "Review evidence with Claude"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"

# docker-compose only: password for the bundled Postgres
POSTGRES_PASSWORD=""
