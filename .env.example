# Folder where the CSV data files are kept. Must be on persistent storage and backed up.
DATA_DIR="./data"

# Public URL of the app (no trailing slash)
NEXTAUTH_URL="https://assurance.ituti.tech"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# The first Ituti admin. This address can always request a sign-in link and becomes an Ituti admin on first sign-in.
BOOTSTRAP_ADMIN_EMAIL="nayan@itutitech.com"

# Outgoing email for sign-in links and invitations. Hostinger mail: smtp.hostinger.com, port 465.
# Microsoft 365: smtp.office365.com, port 587.
# Leave SMTP_HOST empty in development to print links to the server log instead.
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Ituti AI Assurance <assurance@ituti.tech>"

# Optional: enables "Review evidence with Claude"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"
