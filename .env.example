# Folder where the CSV data files are kept. Must be on persistent storage and backed up.
DATA_DIR="./data"

# Public URL of the app (no trailing slash)
NEXTAUTH_URL="https://assurance.itutitech.com"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# The first Ituti admin. This address can always request a sign-in link and becomes an Ituti admin on first sign-in.
BOOTSTRAP_ADMIN_EMAIL="nayan@itutitech.com"

# Outgoing email for sign-in links and invitations (Microsoft 365 example).
# Leave SMTP_HOST empty in development to print links to the server log instead.
SMTP_HOST="smtp.office365.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Ituti AI Assurance <assurance@itutitech.com>"

# Optional: enables "Review evidence with Claude"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"
