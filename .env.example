# MySQL or MariaDB. Tables are created on first start. Either DATABASE_URL, or DB_HOST, DB_PORT, DB_NAME, DB_USER and DB_PASSWORD.
DATABASE_URL="mysql://user:password@127.0.0.1:3306/assurance"

# Folder for uploaded evidence documents. Must be on persistent storage and backed up.
# CSV files from the earlier version found here are imported once into an empty database.
DATA_DIR="./data"

# Public URL of the app (no trailing slash)
NEXTAUTH_URL="https://assurance.ituti.tech"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# The first Ituti admin. This address can always request a sign-in link and becomes an Ituti admin on first sign-in.
BOOTSTRAP_ADMIN_EMAIL="nayan@itutitech.com"

# Outgoing email for sign-in links and invitations. Hostinger mail: smtp.hostinger.com, port 465.
# Microsoft 365: smtp.office365.com, port 587.
# Leave SMTP_HOST empty in development to print links to the server log instead.
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Ituti AI Assurance <assurance@ituti.tech>"

# Optional: enables the assessment agent and "Review evidence with Claude".
# Each client also has to be switched on by an Ituti admin, because their documents are sent to Anthropic's API.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"        # evidence review
ANTHROPIC_AGENT_MODEL="claude-opus-5-5"    # assessment agent and public model research

# Self-service sign-up at /register. New clients get their own workspace with AI assistance switched off until an
# Ituti admin turns it on. Set to "off" for invitation-only access.
SELF_REGISTRATION=open
